[color]
    ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = green
	changed = magenta
	untracked = white

[core]
	editor = vim
	excludesfile = ~/dotfiles/gitignore

[init]
    defaultBranch = main

[pull]
    rebase = true

[rebase]
    autoStash = true

[fetch]
    prune = true

[diff]
    algorithm = histogram
    colorMoved = zebra

[push]
	default = simple

[column]
    ui = auto

[rerere]
    enabled = true

[pager]
    diff = false

[alias]
    lg = log --color --graph --pretty=format:'%Cred%h%Creset-%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lo = !git --no-pager log --oneline --abbrev-commit --all --graph --decorate --color
    a = add
    ap = add -p
    au = add -u
    apu = add -p -u
    ls = !git --no-pager log -n20 --reverse --stat
    s = status
    st = status
    cl = clone
    df = !git diff
    dfc = !git diff --cached
    pullr = pull --rebase
    co = checkout
    sa = stash
    sal = stash list
    sap = stash pop
    sad = stash drop
    sas = git stash show --text
    br = branch
    brd = branch -D
    rh = reset HEAD
    sh = show
    cam = commit --amend
    undo = reset HEAD@{1}
    #update the remote branches reference and delete the branch that doesnt exist anymore on origin.
    rupdate = remote update --prune
    rf = reflog
    #turbo binding - degrade to plain git when the turbo-git npm global is
    # absent (fresh machines get git behavior instead of a cryptic
    # "'tl' is not a git command"); the NVM_DIR probe covers lazy-nvm
    # shells where the nvm bin dir is not on PATH yet - and the probed
    # file is exec'd DIRECTLY (a bare 'git tl' would still fail there)
    l = "!f() { p=\"$(command -v git-tl 2>/dev/null)\"; [ -n \"$p\" ] || p=\"$(ls \"$NVM_DIR\"/versions/node/*/bin/git-tl 2>/dev/null | head -n 1)\"; if [ -n \"$p\" ]; then \"$p\" \"$@\"; else git log --graph --oneline --decorate --color \"$@\"; fi; }; f"
    c = "!f() { p=\"$(command -v git-tc 2>/dev/null)\"; [ -n \"$p\" ] || p=\"$(ls \"$NVM_DIR\"/versions/node/*/bin/git-tc 2>/dev/null | head -n 1)\"; if [ -n \"$p\" ]; then \"$p\" \"$@\"; else git commit \"$@\"; fi; }; f"
    add = "!f() { p=\"$(command -v git-ta 2>/dev/null)\"; [ -n \"$p\" ] || p=\"$(ls \"$NVM_DIR\"/versions/node/*/bin/git-ta 2>/dev/null | head -n 1)\"; if [ -n \"$p\" ]; then \"$p\" \"$@\"; else git add \"$@\"; fi; }; f"
    pf = push --force-with-lease
    unstage = reset HEAD --
    last = log -1 HEAD --stat

# machine-local overrides (never committed) - loaded last so they win;
# git silently skips the include when the file does not exist
[include]
    path = ~/.gitconfig.local
